{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "lib/*": ["lib/*"]
    },
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "lib/**/*.ts"]
}
